generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  admin
  manager
  consultant
}

enum AppointmentStatus {
  scheduled
  confirmed
  rescheduled
  cancelled
  attended
  no_show
  converted
}

model Company {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  logoUrl        String?
  bannerUrl      String?
  primaryColor   String?       @default("#ed1c24")
  secondaryColor String?       @default("#129247")
  buttonColor    String?       @default("#ed1c24")
  backgroundColor String?      @default("#ffffff")
  textColor      String?       @default("#09090b")
  theme          String?       @default("light")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  bookingLinks BookingLink[]
  availability Availability[]
  availabilityRules AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  appointments Appointment[]
  notificationLogs NotificationLog[]
  clients      Client[]
  auditLogs    AuditLog[]
}

model User {
  id           String        @id @default(cuid())
  companyId    String
  name         String
  email        String
  passwordHash String?
  role         UserRole      @default(consultant)
  title        String?
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bookingLinks BookingLink[]
  availabilityRules AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  appointments Appointment[]

  @@unique([companyId, email])
  @@index([companyId])
}

model BookingLink {
  id             String        @id @default(cuid())
  companyId      String
  userId         String?
  slug           String        @unique
  name           String
  title          String?
  description    String?
  imageUrl       String?
  address        String
  instructions   String?
  importantNotes String?
  whatsappUrl    String?
  instagramUrl   String?
  websiteUrl     String?
  duration       Int
  durationMinutes Int?
  consultantPhotoUrl String?
  bannerUrl      String?
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  buttonColor    String?
  backgroundColor String?
  textColor      String?
  theme          String?       @default("auto")
  layout         String?       @default("side")
  welcomeText    String?
  confirmationText String?
  minScheduleNoticeMinutes Int? @default(0)
  maxScheduleDays Int? @default(60)
  allowPublicCancellation Boolean @default(true)
  allowPublicReschedule Boolean @default(true)
  minCancelRescheduleMinutes Int? @default(180)
  dailyLimit     Int
  availableDays  Int[]
  availableSlots String[]
  expiresAt      DateTime?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  availability   Availability[]
  availabilityRules AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  appointments   Appointment[]

  @@index([companyId])
  @@index([slug])
}

model Availability {
  id            String      @id @default(cuid())
  companyId     String
  bookingLinkId String
  dayOfWeek     Int
  startTime     String
  endTime       String
  isBlocked     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bookingLink   BookingLink @relation(fields: [bookingLinkId], references: [id], onDelete: Cascade)

  @@index([companyId, bookingLinkId])
}

model Client {
  id           String        @id @default(cuid())
  companyId    String
  fullName     String
  phone        String
  email        String?
  cpf          String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([companyId])
}

model Appointment {
  id            String            @id @default(cuid())
  companyId     String
  bookingLinkId String
  clientId      String
  userId        String?
  protocol      String            @unique
  startsAt      DateTime
  endsAt        DateTime
  status        AppointmentStatus @default(scheduled)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bookingLink   BookingLink       @relation(fields: [bookingLinkId], references: [id], onDelete: Cascade)
  client        Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  notificationLogs NotificationLog[]

  @@index([companyId, startsAt])
  @@index([companyId, bookingLinkId, startsAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  actorId   String?
  userId    String?
  action    String
  entity    String
  entityType String?
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entity, entityId])
}


model AvailabilityRule {
  id            String      @id @default(cuid())
  companyId     String
  userId        String?
  bookingLinkId String
  weekday       Int
  startTime     String
  endTime       String
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookingLink   BookingLink @relation(fields: [bookingLinkId], references: [id], onDelete: Cascade)

  @@index([companyId, bookingLinkId, weekday])
}

enum AvailabilityExceptionType {
  blocked
  extra
}

model AvailabilityException {
  id            String                    @id @default(cuid())
  companyId     String
  userId        String?
  bookingLinkId String
  date          DateTime
  startTime     String
  endTime       String
  type          AvailabilityExceptionType
  reason        String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  company       Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookingLink   BookingLink               @relation(fields: [bookingLinkId], references: [id], onDelete: Cascade)

  @@index([companyId, bookingLinkId, date])
}

enum NotificationChannel {
  whatsapp
  email
  sms
}

enum NotificationType {
  confirmation
  reminder
  cancellation
  reschedule
}

enum NotificationStatus {
  pending
  sent
  failed
}

model NotificationLog {
  id            String             @id @default(cuid())
  companyId     String
  appointmentId String
  channel       NotificationChannel
  type          NotificationType
  status        NotificationStatus @default(pending)
  payload       Json
  error         String?
  createdAt     DateTime           @default(now())
  sentAt        DateTime?
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([companyId, appointmentId])
}
